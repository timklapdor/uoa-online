---
layout: base.njk
---

<h1>{{ CourseName }} </h1>
<small>{{Programs}}</small>
<p>{{ Description | nl2br |safe }}</p>

<p><strong>Development Cycle: {{ DevCycle }} </strong></p>
<p><em><a href="{{Blueprint}}">Course Blueprint</a></em></p>

<h3>Learning Outcomes</h3>

<ul>
    {% for item in CLOs -%}
    <li>{{ item }}</li>
    {% endfor %}
</ul>

<h3>Development Team</h3>

<ul>
    {% for member in Team -%}
    <li>{{ member.Name }} | {{ member.Role }} | {{ member.Involvement | capitalize }}</li>
    {% endfor %}
</ul>

<h3>Assessments</h3>

<ol>
    {% for assignment in Assessments -%}
    <li>{{ assignment.Name}} | {{ assignment.Weighting }}% | {{ assignment.Type }} | {{ assignment.Description}}</li>
    {% endfor %}
</ol>

<h3>Topics</h3>
<ul>
    {% for topic in Topics -%}
    <li>{{ topic }} </li>
    {% endfor %}
</ul>

<h3>Learning Experience</h3>
{{ content | safe }}

<h3>Learning Resources</h3>

{% for media in Media %}
<div class="media {{ media.Type }}">

    <h4>{{ media.Name }} </h4>
    
        {% if media.Type=="IMG"%}
            <figure>
                <img src="/uoa-online/images/{{ media.Link }}" alt="{{ media.Name }}" title="{{ media.Name }}">
                <figcaption>{{ media.Description }}</figcaption>
            </figure>
        {% endif %}
    
        {% if media.Type=="H5P"%}
            <p>{{ media.Description }} </p>
            <iframe style="width: 779px; height: 600px;" title="{{ media.Name }}" src="{{ media.Link }}" width="800" height="600" loading="lazy" allowfullscreen="allowfullscreen" webkitallowfullscreen="webkitallowfullscreen" mozallowfullscreen="mozallowfullscreen" allow="geolocation *; microphone *; camera *; midi *; encrypted-media *; autoplay *; clipboard-write *; display-capture *"></iframe>
        {% endif %}

        {% if media.Type=="YOUTUBE" %}
            <iframe title="YouTube video player" src="https://www.youtube-nocookie.com/embed/{{ media.Link }}" width="560" height="315" loading="lazy" allowfullscreen="allowfullscreen" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
        {% endif %}

        {% if media.Type=="ECHO" %}
            <p><a href="media.Location">{{ media.Name }}</a></p>
        {% endif %}

        {% if media.Type=="IFRAME"%}
            <p>{{ media.Description }} </p>
            <iframe class="lti-embed" width="100%" height="800" title="{{ media.Name }}" src="{{ media.Link }}" frameborder="0"></iframe>
        {% endif %}

</div>
{% endfor %}

<h3>Course Snapshot</h3>

<ul>
    {% for item in Snapshot %}
            <li><a href="{{ item.Link }}">{{ item.Name }}</a> {{ item.Description }}</li>
    {% endfor %}
</ul>