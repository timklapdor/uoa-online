---
layout: base.njk
---
<main>
  <article>
  <h1>{{ title}} </h1>
    {{ content | safe }}


{%- set teamOrder = ["devel", "futures", "program", "media",  "project"] -%}
{%- set teamNames = {
  "devel": "Course Development",
  "media": "Media Production",
  "program": "Program Coordinators",
  "project": "Project Management",
  "futures": "Learning Futures"
} -%}

{%- for teamKey in teamOrder -%}
  {%- set teamMembers = [] -%}
  {%- for person in people.teamMembers -%}
    {%- if person.team == teamKey -%}
      {%- set temp = teamMembers.push(person) -%}
    {%- endif -%}
  {%- endfor -%}
  
  {%- if teamMembers | length > 0 -%}
    {%- set leads = [] -%}
    {%- set members = [] -%}
    
    {%- for person in teamMembers -%}
      {%- if person.role == "lead" -%}
        {%- set temp = leads.push(person) -%}
      {%- else -%}
        {%- set temp = members.push(person) -%}
      {%- endif -%}
    {%- endfor -%}
    
    {%- set sortedLeads = leads | sort(attribute='name') -%}
    {%- set sortedMembers = members | sort(attribute='name') -%}
    
    <section class="team-group">
      <h2>{{ teamNames[teamKey] }}</h2>
      <ul class="team-list">
      {%- for person in sortedLeads -%}
        <li>
          <strong>{{ person.name }}</strong> – {{ person.position }}
          <span class="badge">Lead</span>
        </li>
      {%- endfor -%}
      {%- for person in sortedMembers -%}
        <li>
          <strong>{{ person.name }}</strong> – {{ person.position }}
        </li>
      {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
{%- endfor -%}


<h2>People Without Images</h2>
<h3>Summary</h3>
{%- set missingCount = 0 -%}
{%- for person in people.teamMembers -%}
  {%- if person.image == "" -%}
    {%- set missingCount = missingCount + 1 -%}
  {%- endif -%}
{%- endfor -%}
<p><strong>{{ missingCount }}</strong> out of <strong>{{ people.teamMembers | length }}</strong> people are missing images.</p>

<ul>
{% for person in people.teamMembers %}
  {% if person.image == "" %}
  <li>{{ person.name | slugify }}</li>
  {% endif %}
{% endfor %}
</ul>



  <h2>Team Members</h2>
    <ul>
    {%- for member in collections.teamMembers -%}
      <li>
        <strong>{{ member.name }}</strong> - {{ member.role }}
        <br>Worked on {{ member.courseCount }} course(s)
      </li>
    {%- endfor -%}
    </ul>

  <!-- Or group by role -->
  <h2>Team by Role</h2>
  {%- for role in collections.teamMembers | uniqueRoles -%}
    <h3>{{ role }}</h3>
    <ul>
    {%- for member in collections.teamMembers | teamByRole(role) -%}
      <li>{{ member.name }} ({{ member.courseCount }} courses)</li>
    {%- endfor -%}
    </ul>
  {%- endfor -%}
  
  </article>
</main>
