---
layout: base.njk
---
<main>
  <article>
  <h1>{{ title}} </h1>
    {{ content | safe }}


{%- set teamOrder = ["devel", "futures", "program", "media",  "project"] -%}
{%- set teamNames = {
  "devel": "Course Development",
  "media": "Media Production",
  "program": "Program Coordinators",
  "project": "Project Management",
  "futures": "Learning Futures"
} -%}

{%- for teamKey in teamOrder -%}
  {%- set teamMembers = [] -%}
  {%- for person in people.teamMembers -%}
    {%- if person.team == teamKey -%}
      {%- set temp = teamMembers.push(person) -%}
    {%- endif -%}
  {%- endfor -%}
  
  {%- if teamMembers | length > 0 -%}
    {%- set leads = [] -%}
    {%- set members = [] -%}
    
    {%- for person in teamMembers -%}
      {%- if person.role == "lead" -%}
        {%- set temp = leads.push(person) -%}
      {%- else -%}
        {%- set temp = members.push(person) -%}
      {%- endif -%}
    {%- endfor -%}
    
    {%- set sortedLeads = leads | sort(attribute='name') -%}
    
    {# Enrich members with course count from collections.teamMembers #}
    {%- set enrichedMembers = [] -%}
    {%- for person in members -%}
      {%- set memberData = collections.teamMembers | find("name", person.name) -%}
      {%- set temp = enrichedMembers.push({
        name: person.name,
        position: person.position,
        team: person.team,
        courseCount: memberData.courseCount if memberData else 0
      }) -%}
    {%- endfor -%}
    
    {%- set sortedMembers = enrichedMembers | sort(true, false, 'courseCount') -%}
    
<section class="team-group">
  <h2>{{ teamNames[teamKey] }}</h2>
  <ul class="team-list">
  {%- for person in sortedLeads -%}
    {%- set personData = people.teamMembers | find("name", person.name) -%}
    <li class="lead" {% if personData and personData.image %}style="background-image: url('/uoa-online/images/people/{{ personData.image }}'); background-size: cover; background-position: center; "{% endif %}>
      <h3>
        {%- set foundPerson = false -%}
          {%- for profile in collections.people -%}
            {%- if profile.data.name == person.name -%}
              {%- set foundPerson = profile -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if foundPerson -%}
            <a href="{{ foundPerson.url | url }}">{{ person.name }}</a>
          {%- else -%}
            {{ person.name }}
          {%- endif -%}
      </h3> 
      <p>{{ person.position }}</p>
    </li>
  {%- endfor -%}
  {%- for person in sortedMembers -%}
    {%- set personData = people.teamMembers | find("name", person.name) -%}
    {%- set memberData = collections.teamMembers | find("name", person.name) -%}
    <li {% if personData and personData.image %}style="background-image: url('/uoa-online/images/people/{{ personData.image }}'); background-size: cover; background-position: center; "{% endif %}>
      <h3>
        {%- set foundPerson = false -%}
          {%- for profile in collections.people -%}
            {%- if profile.data.name == person.name -%}
              {%- set foundPerson = profile -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if foundPerson -%}
            <a href="{{ foundPerson.url | url }}">{{ person.name }}</a>
          {%- else -%}
            {{ person.name }}
          {%- endif -%}
      </h3> 
      <p>{{ person.position }}</p>
    </li>
  {%- endfor -%}
  </ul>
</section>
{%- endif -%}
{%- endfor -%}

<section class="team-group">
  <h2>Course Authors</h2>
  {%- set authors = collections.teamMembers | teamByRole("Course Author") | sort(attribute='name') | sort(true, false, 'courseCount') -%}
  <ul class="team-list">
  {%- for member in authors -%}
    {%- set personData = people.teamMembers | find("name", member.name) -%}
    <li {% if personData and personData.image %}style="background-image: url('/uoa-online/images/people/{{ personData.image }}'); background-size: cover; background-position: center; "{% endif %}>
      <h3>
        {%- set foundPerson = false -%}
          {%- for profile in collections.people -%}
            {%- if profile.data.name == member.name -%}
              {%- set foundPerson = profile -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if foundPerson -%}
            <a href="{{ foundPerson.url | url }}">{{ member.name }}</a>
          {%- else -%}
            {{ member.name }}
          {%- endif -%}
      </h3> 
      <p>{{ member.role }} ({{ member.courseCount }} courses)</p>
    </li>
  {%- endfor -%}
  </ul>
</section>

<h2>People Without Images</h2>
<h3>Summary</h3>
{%- set missingCount = 0 -%}
{%- for person in people.teamMembers -%}
  {%- if person.image == "" -%}
    {%- set missingCount = missingCount + 1 -%}
  {%- endif -%}
{%- endfor -%}
<p><strong>{{ missingCount }}</strong> out of <strong>{{ people.teamMembers | length }}</strong> people are missing images.</p>

<ul>
{% for person in people.teamMembers %}
  {% if person.image == "" %}
  <li>{{ person.name | slugify }}</li>
  {% endif %}
{% endfor %}
</ul>