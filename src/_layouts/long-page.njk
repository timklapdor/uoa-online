---
layout: base.njk
---
<main >
  <div class="long-page">
    {{ content | replace("<p><img", "<figure><img") | replace("></p>", "></figure>") | safe }}
  </div>

  <script>
document.addEventListener('DOMContentLoaded', function() {
  // Add smooth scroll to all existing TOC links
  const tocLinks = document.querySelectorAll('.table-of-contents a[href^="#"]');
  tocLinks.forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const targetId = this.getAttribute('href');
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
  
  // Add back to top link
  const tocList = document.querySelector('.table-of-contents ul');
  
  if (tocList) {
    // Create new list item
    const newLi = document.createElement('li');
    
    // Create the back to top link
    const backLink = document.createElement('a');
    backLink.href = '#{{ title | slugify }}';
    backLink.textContent = '↑ Back to top';
    backLink.className = '';

    // Add smooth scroll
    backLink.addEventListener('click', function(e) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    
    // Add link to list item
    newLi.appendChild(backLink);
    
    // Append to the end of the list
    tocList.appendChild(newLi);
  }
});
</script>
</main>

