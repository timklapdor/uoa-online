---
layout: base.njk
---


<main>
    <article>

    {{ content | safe }}

    <ol>
        {% for item in collections.courses | sort(false, false, 'data.DevCycle') |  sort(attribute="data.name") -%}
        <li><a href="{{ item.url |url }}">{{ item.data.CourseName }}</a> {{item.data.DevCycle}}
        {% for member in item.data.Team %}
            <span class="lead">{{ member.Name if member.Role=="Learning Designer" and member.Involvement=="Lead"}}</span>
        {% endfor %}
        {% if item.data.ToDo | length %}<ul>{%for item in item.data.ToDo %}<li class="job">{{item}}</li> {% endfor %}</ul> {% endif %} </li>
        {% endfor %}
    </ol>
    </article>
</main>