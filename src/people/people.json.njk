---
permalink: /data/people.json
eleventyExcludeFromCollections: true
---
{%- set uniqueMembers = [] -%}
{%- set seenNames = [] -%}
{%- for member in collections.teamMembers -%}
  {%- set memberName = member.name -%}
  {%- if memberName and memberName not in seenNames -%}
    {%- set temp = seenNames.push(memberName) -%}
    {%- set temp = uniqueMembers.push(memberName) -%}
  {%- endif -%}
{%- endfor -%}
{%- set sortedMembers = uniqueMembers | sort -%}
{
  "people": [
{%- for memberName in sortedMembers -%}
    {
      "name": "{{ memberName | safe }}",
      "image": ""
    }{% if not loop.last %},{% endif %}
{%- endfor -%}
  ]
}